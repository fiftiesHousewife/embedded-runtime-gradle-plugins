# Container image for @APP_NAME@, built from the same bundle that is installed on servers.
# Generated by io.github.fiftieshousewife.platform; override with src/bundle/docker/Dockerfile.
#
# The base image needs only glibc and /bin/sh — the Java or Node runtime is inside the bundle,
# so there is exactly one runtime version to track. Point BASE_IMAGE at your registry mirror.
ARG BASE_IMAGE=registry.access.redhat.com/ubi9/ubi-minimal:9.6
FROM ${BASE_IMAGE}

COPY --chown=1001:0 app/ /app/

ENV APP_ROOT=/var/lib/app \
    APP_CONF_DIR=/config \
    APP_DATA_DIR=/var/lib/app/data \
    APP_LOG_DIR=/var/lib/app/logs \
    APP_LOG_TARGET=stdout \
    APP_PORT=8080

USER 1001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s CMD ["/app/bin/@APP_NAME@", "healthcheck"]
ENTRYPOINT ["/app/bin/@APP_NAME@", "run"]

# UBI micro: no package manager, only what an app with its own runtime needs to start (Java only;
# Node.js needs libstdc++, which micro leaves out).
ARG BASE_IMAGE=registry.access.redhat.com/ubi9/ubi-micro:9.8-1791895366@sha256:5be877a2a280ae36eb9ab80ca4efb28bbf77c57abbba38137cdc37a03b8465e6
FROM ${BASE_IMAGE}

ARG TARGETARCH
ARG BASE_IMAGE
ARG APP_VERSION
ARG GIT_COMMIT
ARG CREATED

LABEL org.opencontainers.image.title="spring-boot-service" \
      org.opencontainers.image.source="https://github.com/fiftiesHousewife/embedded-runtime-gradle-plugins.git" \
      org.opencontainers.image.licenses="LicenseRef-Proprietary" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}"

RUN mkdir -p /var/lib/app/data /var/lib/app/logs && chown -R 1001:0 /var/lib/app && chmod -R g=u /var/lib/app

COPY --chown=1001:0 runtime/${TARGETARCH}/ /app/runtime/
COPY --chown=1001:0 app/${TARGETARCH}/ /app/

ENV APP_ROOT=/var/lib/app \
    APP_CONF_DIR=/config \
    APP_DATA_DIR=/var/lib/app/data \
    APP_LOG_DIR=/var/lib/app/logs \
    APP_LOG_TARGET=stdout \
    APP_PORT=8080

USER 1001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s CMD ["/app/bin/spring-boot-service", "healthcheck", "ready"]
STOPSIGNAL SIGTERM
ENTRYPOINT ["/app/bin/spring-boot-service", "run"]

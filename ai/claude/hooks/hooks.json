{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/embedded-runtime-check-gradle-build.sh\"",
            "timeout": 300,
            "statusMessage": "Checking the Gradle build still configures"
          }
        ]
      }
    ]
  }
}

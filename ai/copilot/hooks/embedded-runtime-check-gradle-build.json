{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "matcher": "edit|create",
        "bash": "sh .github/hooks/embedded-runtime-check-gradle-build.sh",
        "cwd": ".",
        "env": { "EMBEDDED_RUNTIME_HOOK_FORMAT": "copilot" },
        "timeoutSec": 300
      }
    ]
  }
}

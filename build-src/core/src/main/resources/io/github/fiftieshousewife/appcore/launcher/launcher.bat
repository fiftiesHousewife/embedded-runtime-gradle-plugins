@echo off
rem Launcher for @APP_NAME@ - generated by the io.github.fiftieshousewife.java-app or .node-app plugin; do not edit.
rem Usage: @APP_NAME@ run [args...] ^| healthcheck ^| version
rem Environment: see the POSIX launcher; APP_ROOT, APP_CONF_DIR, APP_DATA_DIR, APP_LOG_DIR,
rem APP_LOG_TARGET, APP_PORT, APP_JAVA_OPTS / APP_NODE_OPTS.
setlocal EnableExtensions

for %%I in ("%~dp0..") do set "APP_HOME=%%~fI"
set "APP_NAME=@APP_NAME@"

if not defined APP_ROOT (
  for %%I in ("%APP_HOME%\..") do set "APP_PARENT=%%~nxI"
  for %%I in ("%APP_HOME%\..\..") do set "APP_GRANDPARENT=%%~fI"
)
if not defined APP_ROOT (
  if /i "%APP_PARENT%"=="releases" (set "APP_ROOT=%APP_GRANDPARENT%") else (set "APP_ROOT=%APP_HOME%")
)
if not defined APP_CONF_DIR set "APP_CONF_DIR=%APP_ROOT%\conf"
if not defined APP_DATA_DIR set "APP_DATA_DIR=%APP_ROOT%\data"
if not defined APP_LOG_DIR set "APP_LOG_DIR=%APP_ROOT%\logs"
if not defined APP_LOG_TARGET set "APP_LOG_TARGET=file"

set "COMMAND=%~1"
set "ARGS="
:collect
shift
if "%~1"=="" goto collected
set ARGS=%ARGS% %1
goto collect
:collected

if /i "%COMMAND%"=="run" goto launch
if /i "%COMMAND%"=="healthcheck" (set "ARGS= --healthcheck%ARGS%" & goto launch)
if /i "%COMMAND%"=="version" (type "%APP_HOME%\META-INF\app.json" & exit /b 0)
echo Usage: %APP_NAME% run [args...] ^| healthcheck ^| version 1>&2
exit /b 64

:launch
@POLICY@@EXEC@
exit /b %ERRORLEVEL%

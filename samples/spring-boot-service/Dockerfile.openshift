# OpenShift runs the image as an arbitrary user in group 0, so it has no USER: what that user must
# write is owned by group 0 and as writable for the group as for its owner.
ARG BASE_IMAGE=registry.access.redhat.com/ubi9/ubi-minimal:9.8-1793050346@sha256:6f3a78179e0b30b930a186e7f68a4af52e51bb82406c9653be10bddd624e40f5
FROM ${BASE_IMAGE}

ARG TARGETARCH
ARG BASE_IMAGE
ARG APP_VERSION
ARG GIT_COMMIT
ARG CREATED
ARG RELEASE=1

# The base image's own name, vendor, version and the rest would otherwise describe UBI, not the app;
# Red Hat's certification requires them, and the OpenShift console shows them.
LABEL org.opencontainers.image.title="spring-boot-service" \
      org.opencontainers.image.source="https://github.com/fiftiesHousewife/embedded-runtime-gradle-plugins.git" \
      org.opencontainers.image.licenses="LicenseRef-Proprietary" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      name="spring-boot-service" \
      vendor="fiftiesHousewife" \
      maintainer="fiftiesHousewife" \
      version="${APP_VERSION}" \
      release="${RELEASE}" \
      summary="Order service on Spring Boot" \
      description="Order service on Spring Boot with its own Oracle Java runtime" \
      url="https://github.com/fiftiesHousewife/embedded-runtime-gradle-plugins" \
      vcs-ref="${GIT_COMMIT}" \
      build-date="${CREATED}" \
      io.k8s.display-name="spring-boot-service" \
      io.k8s.description="Order service on Spring Boot with its own Oracle Java runtime" \
      io.openshift.tags="java,spring-boot" \
      io.openshift.expose-services="8080:http"

RUN mkdir -p /var/lib/app/data /var/lib/app/logs && chgrp -R 0 /var/lib/app && chmod -R g=u /var/lib/app

COPY --chown=1001:0 runtime/${TARGETARCH}/ /app/runtime/
# The terms the image ships under, as regular files: Red Hat's certification skips links.
COPY runtime/${TARGETARCH}/legal/ /licenses/java-runtime/
COPY --chown=1001:0 app/${TARGETARCH}/ /app/

# An arbitrary user has no passwd entry, so HOME would be /, which it can't write.
ENV APP_ROOT=/var/lib/app \
    APP_CONF_DIR=/config \
    APP_DATA_DIR=/var/lib/app/data \
    APP_LOG_DIR=/var/lib/app/logs \
    APP_LOG_TARGET=stdout \
    APP_PORT=8080 \
    HOME=/var/lib/app

EXPOSE 8080
STOPSIGNAL SIGTERM
ENTRYPOINT ["/app/bin/spring-boot-service", "run"]

# Shell scripts must keep LF even on Windows checkouts with core.autocrlf=true:
# a CRLF script fails with "/usr/bin/env: 'bash\r': No such file or directory".
*.sh        text eol=lf
gradlew     text eol=lf
*.service   text eol=lf
# A Dockerfile is built on Linux: CRLF would break its `\` line continuations.
Dockerfile  text eol=lf
*.bat       text eol=crlf
*.jar       binary
*.tar.gz    binary
